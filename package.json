{
  "name": "pi-orchestrator",
  "version": "0.1.0",
  "description": "Pi package: a model router for subagent delegations and a personal model ban-list guard.",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egonm12/pi-orchestrator.git"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./src/router/extension.ts",
      "./src/guard/extension.ts",
      "./src/subagents/extension.ts"
    ]
  },
  "scripts": {
    "test": "node --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.0",
    "@earendil-works/pi-tui": ">=0.99.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.0",
    "@earendil-works/pi-tui": "^0.99.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
